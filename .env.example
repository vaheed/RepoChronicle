# Copy to .env. Never commit real credentials or production source data.
RC_ENV=development
RC_LOG_LEVEL=INFO
RC_PUBLIC_API_URL=http://localhost:8080
RC_API_HOST=0.0.0.0
RC_API_PORT=8080
RC_MCP_HOST=0.0.0.0
RC_MCP_PORT=8090
# Host ports bind to loopback by default; expose remotely only behind an authenticated TLS proxy.
RC_API_BIND_HOST=127.0.0.1
RC_MCP_BIND_HOST=127.0.0.1
RC_OLLAMA_BIND_HOST=127.0.0.1

# Container DNS names are used inside Compose.
RC_DB_PASSWORD=change-me-local-only
RC_DATABASE_URL=postgresql://repochronicle:change-me-local-only@db:5432/repochronicle
RC_VALKEY_URL=redis://valkey:6379/0
RC_DATABASE_CONNECT_TIMEOUT_SECONDS=5
RC_PROVIDER_HTTP_TIMEOUT_SECONDS=30
RC_MAX_CONTEXT_CHARS=24000

# Model providers are disabled until configured. Use a secret manager in production.
RC_LLM_PROVIDER=openai-compatible
RC_LLM_BASE_URL=
RC_LLM_API_KEY=
RC_LLM_MODEL=
RC_EMBEDDING_PROVIDER=local
RC_EMBEDDING_BASE_URL=
RC_EMBEDDING_API_KEY=
RC_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RC_EMBEDDING_DIMENSIONS=384
RC_EMBEDDING_ENABLED=true
RC_MODEL_CACHE_DIR=/var/lib/repochronicle/models

# Telegram Business is optional. Standard Bot API is supported.
RC_TELEGRAM_BOT_TOKEN=
RC_TELEGRAM_WEBHOOK_SECRET=
RC_TELEGRAM_ALLOWED_CHAT_IDS=
RC_TELEGRAM_DEFAULT_MODE=mention_only

# Discord requires explicit server/channel permissions and Message Content Intent when needed.
RC_DISCORD_BOT_TOKEN=
RC_DISCORD_ALLOWED_GUILD_IDS=
RC_DISCORD_ALLOWED_CHANNEL_IDS=
RC_DISCORD_DEFAULT_MODE=mention_only

# Use secret references in production. These example env fields are for local development only.
RC_ALLOWED_GIT_HOSTS=github.com,gitlab.com
RC_BOOTSTRAP_MAX_FILE_BYTES=2000000
RC_BOOTSTRAP_MAX_REPOSITORY_BYTES=2000000000
RC_BOOTSTRAP_BACKFILL_DAYS=365
RC_RECONCILIATION_INTERVAL_SECONDS=21600
